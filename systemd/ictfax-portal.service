[Unit]
Description=ICTFax React/Vite Portal (Express BFF)
Documentation=https://github.com/HatchetMan111/ICTFax-Proxmox
After=network-online.target ictfax.service
Wants=network-online.target

[Service]
Type=simple
User=ictfax-portal
Group=ictfax-portal
WorkingDirectory=/opt/ictfax/portal
EnvironmentFile=/etc/ictfax-portal/config.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
# Der Portal-Dienst ist ein normaler Node-Prozess mit Lesezugriff auf
# /usr (node), /etc/ssl (openssl.cnf) und /opt/ictfax. Keine Härtung, die
# den Start bricht (ProtectSystem=strict hat /etc gesperrt → node starb
# mit "fopen(/etc/ssl/openssl.cnf) Permission denied", selbst als root-
# lesbare Datei, weil die Sandbox /etc read-only-for-other mountete).
# Netzwerk bleibt offen (Port 8080). ReadWritePaths nur für /var/lib.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=false
ProtectHome=true
ReadWritePaths=/var/lib/ictfax-portal
StateDirectory=ictfax-portal
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
