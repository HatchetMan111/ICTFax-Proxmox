[Unit]
Description=ICTFax React/Vite Portal (Express BFF)
Documentation=https://github.com/HatchetMan111/ICTFax-Proxmox
After=network-online.target ictfax.service
Wants=network-online.target

[Service]
Type=simple
User=ictfax-portal
Group=ictfax-portal
WorkingDirectory=/opt/ictfax/portal
EnvironmentFile=/etc/ictfax-portal/config.env
# Wichtig: /usr/bin/node liest /etc/ssl/openssl.cnf (OpenSSL-Init). Die Datei
# ist 0644, ABER /etc/ssl und /usr/lib/openssl müssen für den portal-User
# traversierbar sein (0755). ProtectSystem=strict sperrte /usr + /etc als
# read-only-mount → "Permission denied" beim fopen (Live-Grube). Darum:
# keine Dateisystem-Sandbox, nur NoNewPrivileges + PrivateTmp.
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=false
ProtectHome=true
ReadWritePaths=/var/lib/ictfax-portal
StateDirectory=ictfax-portal
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target