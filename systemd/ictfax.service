[Unit]
Description=ICTFax (Docker Compose)
Documentation=https://github.com/HatchetMan111/ICTFax-Proxmox
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# `docker compose up -d --wait` stages the stack and EXITS once every
# container is running/healthy. With Type=simple + Restart=always that made
# systemd restart the unit every RestartSec forever: `systemctl is-active`
# stayed in "activating (auto-restart)" and both the installer and the reboot
# test failed even though the containers were up. oneshot + RemainAfterExit is
# the correct shape for "run to completion, then stay active".
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ictfax/docker
ExecStart=/usr/local/bin/ictfax-compose up
ExecStop=/usr/local/bin/ictfax-compose down
Restart=on-failure
RestartSec=15
# First boot pulls a ~630 MB image, initialises MariaDB and loads the schema.
# That legitimately takes several minutes on a slow line.
TimeoutStartSec=1800
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
